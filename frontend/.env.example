# Where the FastAPI backend lives.
# Left empty in dev: requests go to /api and Vite proxies them (see vite.config.ts).
VITE_API_BASE_URL=

# Dev-only override if the backend runs somewhere other than 127.0.0.1:8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# The server-rendered admin back office, which the sidebar's Administration link
# points at. Left relative in dev: /admin is proxied by Vite alongside /api, so
# the link resolves on whatever origin the app is served from — including a
# tunnel, where the backend's own port is not exposed. Set this only if the back
# office lives somewhere the app is not proxying.
VITE_ADMIN_URL=
